# ============================================================
# Telegram Bot credentials
# ============================================================
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789

# Private channel ID for charged-hit logs (negative integer)
PVT_CHANNEL_ID=-1001234567890

# ============================================================
# Checker API endpoints (comma-separated base URLs, no trailing slash)
# Example: http://VPS1_IP:5000,http://VPS2_IP:5000,http://VPS3_IP:5000
# ============================================================
API_ENDPOINTS=http://VPS1_IP:5000,http://VPS2_IP:5000,http://VPS3_IP:5000

# ============================================================
# SQLite database file for credits (bot machine)
# ============================================================
DB_FILE=bot_data.db

# ============================================================
# API port (used when running api.py directly)
# ============================================================
PORT=5000
